msgstr "Contraseña (se guarda en el llavero de GNOME)"

#: lib/popup.js:736
msgid "Password (⚠ no keyring available: stored unencrypted)"
msgstr "Contraseña (⚠ sin llavero: se guarda sin cifrar)"

