#: extension.js:252
#, javascript-format
msgid "Could not open the preferences: %s"
msgstr "No se pudieron abrir las preferencias: %s"

#: extension.js:310
#, javascript-format
msgid "Could not load the image: %s"
msgstr "No se pudo cargar la imagen: %s"

#: extension.js:324
#, javascript-format
msgid "Could not read the password from the keyring: %s"
msgstr "No se pudo leer la contraseña del llavero: %s"

#: extension.js:330
#, javascript-format
msgid "“%s” has no saved password"
msgstr "«%s» no tiene contraseña guardada"

#: extension.js:348
msgid "Pasted into the focused field and copied to the clipboard."
msgstr "Pegada en el campo activo y copiada al portapapeles."

#: extension.js:349
msgid "Copied to the clipboard."
msgstr "Copiada al portapapeles."

#: extension.js:351
#, javascript-format
msgid "The clipboard will be cleared in %d seconds."
msgstr "El portapapeles se borrará en %d segundos."

#: extension.js:355
msgid "Password generated"
msgstr "Contraseña generada"

#: extension.js:359
msgid "Save as account"
msgstr "Guardar como cuenta"

#: prefs.js:60
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:99
msgid "General"
msgstr "General"

#: prefs.js:102
msgid "Keyboard Shortcuts"
msgstr "Atajos de teclado"

#: prefs.js:103
msgid ""
"GTK accelerator syntax, e.g. <Super>v or <Control><Alt>h. Applied on Enter "
"or when leaving the field; leave empty to disable."
msgstr ""
"Formato de GTK, p. ej. <Super>v o <Control><Alt>h. Se aplica al pulsar Intro "
"o al salir del campo; déjalo vacío para desactivarlo."

#: prefs.js:104
msgid "Open history"
msgstr "Abrir historial"

#: prefs.js:105
msgid "Open notes & accounts"
msgstr "Abrir notas y cuentas"

#: prefs.js:106 lib/popup.js:368
msgid "Generate a password and paste it"
msgstr "Generar una contraseña y pegarla"

#: prefs.js:107
msgid "Take over Super+V from GNOME"
msgstr "Liberar Super+V de GNOME"

#: prefs.js:108
msgid ""
"GNOME uses Super+V to open the notification list. It is removed there and "
"restored when the extension is disabled."
msgstr ""
"GNOME usa Super+V para abrir las notificaciones. Se quita de ahí y se "
"restaura al desactivar la extensión."

#: prefs.js:111
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:112
msgid "Paste on select"
msgstr "Pegar al seleccionar"

#: prefs.js:113
msgid "When disabled, selecting an item only copies it to the clipboard"
msgstr ""
"Si está desactivado, al elegir un elemento solo se copia al portapapeles"

#: prefs.js:114
msgid "Keys used to paste text"
msgstr "Teclas para pegar texto"

#: prefs.js:115
msgid "Shift+Insert (also works in terminals)"
msgstr "Shift+Insert (funciona también en terminales)"

#: prefs.js:116
msgid "Ctrl+V"
msgstr "Ctrl+V"

#: prefs.js:118
msgid "Popup position"
msgstr "Posición de la ventana"

#: prefs.js:119
msgid "Next to the text cursor (like Windows)"
msgstr "Junto al cursor de texto (como en Windows)"

#: prefs.js:120
msgid "Next to the mouse pointer"
msgstr "Junto al puntero del ratón"

#: prefs.js:121
msgid "Center of the screen"
msgstr "Centro de la pantalla"

#: prefs.js:123
msgid "Width"
msgstr "Ancho"

#: prefs.js:123 prefs.js:124
msgid "pixels"
msgstr "píxeles"

#: prefs.js:124
msgid "Height"
msgstr "Alto"

#: prefs.js:125
msgid "Top bar icon"
msgstr "Icono en la barra superior"

#: prefs.js:126
msgid "Click: history · right click: notes · middle click: private mode"
msgstr "Clic: historial · clic derecho: notas · clic central: modo privado"

#: prefs.js:130 prefs.js:133 lib/popup.js:346
msgid "History"
msgstr "Historial"

#: prefs.js:134
msgid "Maximum size"
msgstr "Tamaño máximo"

#: prefs.js:134
msgid "Unpinned items to keep"
msgstr "Elementos no fijados que se conservan"

#: prefs.js:135
msgid "Lines shown per item"
msgstr "Líneas por elemento"

#: prefs.js:136
msgid "Longer text is cut with “…”"
msgstr "El texto más largo se corta con «…»"

#: prefs.js:137
msgid "Keep history across sessions"
msgstr "Conservar entre sesiones"

#: prefs.js:138
msgid "Save the history to disk so it survives restarts"
msgstr "Guarda el historial en disco para que sobreviva a los reinicios"

#: prefs.js:139
msgid "Save images"
msgstr "Guardar imágenes"

#: prefs.js:140
msgid "Maximum image size"
msgstr "Tamaño máximo de imagen"

#: prefs.js:140
msgid "MiB"
msgstr "MiB"

#: prefs.js:143
msgid "Privacy"
msgstr "Privacidad"

#: prefs.js:144
msgid "Private mode"
msgstr "Modo privado"

#: prefs.js:144
msgid "Do not record anything that is copied"
msgstr "No registrar nada de lo que se copie"

#: prefs.js:145
msgid "Ignore secret content"
msgstr "Ignorar contenido secreto"

#: prefs.js:146
msgid ""
"Honor the hint set by password managers such as KeePassXC when they copy a "
"password"
msgstr ""
"Respeta la marca que ponen gestores como KeePassXC al copiar una contraseña"

#: prefs.js:153
msgid "Accounts"
msgstr "Cuentas"

#: prefs.js:156 lib/popup.js:347
msgid "Notes & Accounts"
msgstr "Notas y cuentas"

#: prefs.js:157
msgid ""
"Passwords are stored encrypted in the GNOME Keyring (Passwords and Keys / "
"Seahorse). Titles, usernames and notes are stored in the data folder."
msgstr ""
"Las contraseñas se guardan cifradas en el llavero de GNOME (Contraseñas y "
"claves / Seahorse). Los títulos, usuarios y notas se guardan en la carpeta "
"de datos."

#: prefs.js:158
msgid "Clear copied passwords after"
msgstr "Borrar las contraseñas copiadas tras"

#: prefs.js:159
msgid "seconds (0 = never)"
msgstr "segundos (0 = nunca)"

#: prefs.js:162
msgid "Data folder"
msgstr "Carpeta de datos"

#: prefs.js:172
msgid "About"
msgstr "Acerca de"

#: prefs.js:176
#, javascript-format
msgid "Version %s · Report issues and contribute on GitHub"
msgstr "Versión %s · Informa de errores y colabora en GitHub"

#: prefs.js:186
msgid "Passwords"
msgstr "Contraseñas"

#: prefs.js:188
msgid "Password Generator"
msgstr "Generador de contraseñas"

#: prefs.js:189
msgid ""
"Used by the shortcut, the key button in the popup and the account editor. "
"Passwords come from a cryptographic random source and include at least one "
"character of every enabled type."
msgstr "Se usa en el atajo, en el botón de la llave de la ventana y en el editor de cuentas. Las contraseñas salen de una fuente aleatoria criptográfica e incluyen al menos un carácter de cada tipo activado."

#: prefs.js:190
msgid "Shortcut"
msgstr "Atajo"

#: prefs.js:191
msgid "Length"
msgstr "Longitud"

#: prefs.js:191
msgid "characters"
msgstr "caracteres"

#: prefs.js:192
msgid "Uppercase letters"
msgstr "Mayúsculas"

#: prefs.js:193
msgid "Lowercase letters"
msgstr "Minúsculas"

#: prefs.js:194
msgid "Digits"
msgstr "Números"

#: prefs.js:197
msgid "Symbols"
msgstr "Símbolos"

#: prefs.js:202
msgid "Allowed symbols"
msgstr "Símbolos permitidos"

#: prefs.js:207
msgid "Restore the default symbols"
msgstr "Restaurar los símbolos predeterminados"

#: prefs.js:215
msgid "Avoid look-alike characters"
msgstr "Evitar caracteres parecidos"

#: prefs.js:216
msgid ""
"Leaves out characters that are easy to confuse, like 0 and O or 1, l and I"
msgstr "Omite caracteres fáciles de confundir, como 0 y O o 1, l e I"

#: prefs.js:220
msgid "Preview"
msgstr "Vista previa"

#: prefs.js:236
msgid "Generate another one"
msgstr "Generar otra"

#: prefs.js:249
msgid "Weak"
msgstr "Débil"

#: prefs.js:251
msgid "Fair"
msgstr "Aceptable"

#: prefs.js:253
msgid "Strong"
msgstr "Fuerte"

#: prefs.js:255
msgid "Very strong"
msgstr "Muy fuerte"

#: prefs.js:256
#, javascript-format
msgid "Strength: %s (about %d bits of entropy)"
msgstr "Fortaleza: %s (unos %d bits de entropía)"

