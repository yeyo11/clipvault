#: extension.js:267
#, javascript-format
msgid "Could not load the image: %s"
msgstr "No se pudo cargar la imagen: %s"

#: extension.js:281
#, javascript-format
msgid "Could not read the password from the keyring: %s"
msgstr "No se pudo leer la contraseña del llavero: %s"

#: extension.js:287
#, javascript-format
msgid "“%s” has no saved password"
msgstr "«%s» no tiene contraseña guardada"

#: prefs.js:48
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:80
msgid "General"
msgstr "General"

#: prefs.js:84
msgid "Keyboard Shortcuts"
msgstr "Atajos de teclado"

#: prefs.js:85
msgid ""
"GTK accelerator syntax, e.g. <Super>v or <Control><Alt>h. Applied on Enter "
"or when leaving the field; leave empty to disable."
msgstr ""
"Formato de GTK, p. ej. <Super>v o <Control><Alt>h. Se aplica al pulsar Intro "
"o al salir del campo; déjalo vacío para desactivarlo."

#: prefs.js:87
msgid "Open history"
msgstr "Abrir historial"

#: prefs.js:88
msgid "Open notes & accounts"
msgstr "Abrir notas y cuentas"

#: prefs.js:89
msgid "Take over Super+V from GNOME"
msgstr "Liberar Super+V de GNOME"

#: prefs.js:90
msgid ""
"GNOME uses Super+V to open the notification list. It is removed there and "
"restored when the extension is disabled."
msgstr ""
"GNOME usa Super+V para abrir las notificaciones. Se quita de ahí y se "
"restaura al desactivar la extensión."

#: prefs.js:93
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:94
msgid "Paste on select"
msgstr "Pegar al seleccionar"

#: prefs.js:95
msgid "When disabled, selecting an item only copies it to the clipboard"
msgstr ""
"Si está desactivado, al elegir un elemento solo se copia al portapapeles"

#: prefs.js:96
msgid "Keys used to paste text"
msgstr "Teclas para pegar texto"

#: prefs.js:97
msgid "Shift+Insert (also works in terminals)"
msgstr "Shift+Insert (funciona también en terminales)"

#: prefs.js:98
msgid "Ctrl+V"
msgstr "Ctrl+V"

#: prefs.js:100
msgid "Popup position"
msgstr "Posición de la ventana"

#: prefs.js:101
msgid "Next to the text cursor (like Windows)"
msgstr "Junto al cursor de texto (como en Windows)"

#: prefs.js:102
msgid "Next to the mouse pointer"
msgstr "Junto al puntero del ratón"

#: prefs.js:103
msgid "Center of the screen"
msgstr "Centro de la pantalla"

#: prefs.js:105
msgid "Width"
msgstr "Ancho"

#: prefs.js:105 prefs.js:106
msgid "pixels"
msgstr "píxeles"

#: prefs.js:106
msgid "Height"
msgstr "Alto"

#: prefs.js:107
msgid "Top bar icon"
msgstr "Icono en la barra superior"

#: prefs.js:108
msgid "Click: history · right click: notes · middle click: private mode"
msgstr "Clic: historial · clic derecho: notas · clic central: modo privado"

#: prefs.js:112 prefs.js:115 lib/popup.js:209
msgid "History"
msgstr "Historial"

#: prefs.js:116
msgid "Maximum size"
msgstr "Tamaño máximo"

#: prefs.js:116
msgid "Unpinned items to keep"
msgstr "Elementos no fijados que se conservan"

#: prefs.js:117
msgid "Keep history across sessions"
msgstr "Conservar entre sesiones"

#: prefs.js:118
msgid "Save the history to disk so it survives restarts"
msgstr "Guarda el historial en disco para que sobreviva a los reinicios"

#: prefs.js:119
msgid "Save images"
msgstr "Guardar imágenes"

#: prefs.js:120
msgid "Maximum image size"
msgstr "Tamaño máximo de imagen"

#: prefs.js:120
msgid "MiB"
msgstr "MiB"

#: prefs.js:123
msgid "Privacy"
msgstr "Privacidad"

#: prefs.js:124
msgid "Private mode"
msgstr "Modo privado"

#: prefs.js:124
msgid "Do not record anything that is copied"
msgstr "No registrar nada de lo que se copie"

#: prefs.js:125
msgid "Ignore secret content"
msgstr "Ignorar contenido secreto"

#: prefs.js:126
msgid ""
"Honor the hint set by password managers such as KeePassXC when they copy a "
"password"
msgstr ""
"Respeta la marca que ponen gestores como KeePassXC al copiar una contraseña"

#: prefs.js:130
msgid "Accounts"
msgstr "Cuentas"

#: prefs.js:134 lib/popup.js:210
msgid "Notes & Accounts"
msgstr "Notas y cuentas"

#: prefs.js:135
msgid ""
"Passwords are stored encrypted in the GNOME Keyring (Passwords and Keys / "
"Seahorse). Titles, usernames and notes are stored in the data folder."
msgstr ""
"Las contraseñas se guardan cifradas en el llavero de GNOME (Contraseñas y "
"claves / Seahorse). Los títulos, usuarios y notas se guardan en la carpeta "
"de datos."

#: prefs.js:137
msgid "Clear copied passwords after"
msgstr "Borrar las contraseñas copiadas tras"

#: prefs.js:138
msgid "seconds (0 = never)"
msgstr "segundos (0 = nunca)"

#: prefs.js:141
msgid "Data folder"
msgstr "Carpeta de datos"

#: prefs.js:151
msgid "About"
msgstr "Acerca de"

#: prefs.js:154
#, javascript-format
msgid "Version %s · Report issues and contribute on GitHub"
msgstr "Versión %s · Informa de errores y colabora en GitHub"

#: lib/popup.js:32
msgid "↵ paste · ⇧↵ copy · Ctrl+P pin · Ctrl+S to notes · Del remove"
msgstr "↵ pegar · ⇧↵ copiar · Ctrl+P fijar · Ctrl+S a notas · Supr borrar"

#: lib/popup.js:34
msgid "↵ paste · Ctrl+U username · Ctrl+N new · Ctrl+E edit · Del remove"
msgstr "↵ pegar · Ctrl+U usuario · Ctrl+N nueva · Ctrl+E editar · Supr borrar"

#: lib/popup.js:36
msgid "Ctrl+S / Ctrl+↵ save · Tab next field · Esc cancel"
msgstr "Ctrl+S / Ctrl+↵ guardar · Tab siguiente campo · Esc cancelar"

#: lib/popup.js:59
msgid "now"
msgstr "ahora"

#: lib/popup.js:61
#, javascript-format
msgid "%d min"
msgstr "%d min"

#: lib/popup.js:63
#, javascript-format
msgid "%d h"
msgstr "%d h"

#: lib/popup.js:65
#, javascript-format
msgid "%d d"
msgstr "%d d"

#: lib/popup.js:238
msgid "Search…"
msgstr "Buscar…"

#: lib/popup.js:393
msgid "image"
msgstr "imagen"

#: lib/popup.js:433
msgid "No results"
msgstr "Sin resultados"

#: lib/popup.js:435
msgid ""
"No notes or accounts yet.\n"
"Press + or Ctrl+N to create one."
msgstr ""
"Todavía no hay notas ni cuentas.\n"
"Pulsa + o Ctrl+N para crear una."

#: lib/popup.js:437
msgid "Private mode is on: nothing is being recorded."
msgstr "Modo privado activo: no se está guardando nada."

#: lib/popup.js:438
msgid ""
"Your clipboard history is empty.\n"
"Copy something with Ctrl+C."
msgstr ""
"El historial está vacío.\n"
"Copia algo con Ctrl+C."

#: lib/popup.js:480
msgid "(whitespace)"
msgstr "(espacios en blanco)"

#: lib/popup.js:533
msgid "Untitled"
msgstr "Sin título"

#: lib/popup.js:550 lib/popup.js:711
msgid "Username"
msgstr "Usuario"

#: lib/popup.js:554
msgid "Password"
msgstr "Contraseña"

#: lib/popup.js:602
msgid "This account has no username"
msgstr "Esta cuenta no tiene usuario"

#: lib/popup.js:620
msgid "Press again to delete permanently"
msgstr "Pulsa otra vez para borrar definitivamente"

#: lib/popup.js:639
msgid "Press again to clear the history (pinned items are kept)"
msgstr "Pulsa otra vez para vaciar el historial (se conservan los fijados)"

#: lib/popup.js:687
msgid "Note"
msgstr "Nota"

#: lib/popup.js:688
msgid "Account"
msgstr "Cuenta"

